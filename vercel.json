{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tine-opener.html",
      "destination": "/stag-opener.html",
      "permanent": true
    },
    {
      "source": "/stem-opener.html",
      "destination": "/stag-opener.html",
      "permanent": true
    },
    {
      "source": "/corkscrew.html",
      "destination": "/shop.html",
      "permanent": true
    },
    {
      "source": "/the-set.html",
      "destination": "/bundle.html",
      "permanent": true
    },
    {
      "source": "/cart.html",
      "destination": "/shop.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    }
  ],
  "headers": [
    {
      "source": "/portal(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
